<h1><%= @event.name %></h1>

<p>Date: <%= @event.date %></p>
<p>Location: <%= @event.location %></p>
<p>
  Visibility:
  <%= @event.private? ? "Private Event" : "Public Event" %>
</p>

<% if current_user == @event.creator %>
  <%= link_to "Edit Event", edit_event_path(@event) %>

  <%= button_to "Delete Event",
      event_path(@event),
      method: :delete,
      data: { turbo_confirm: "Are you sure you want to delete this event?" } %>
<% end %>

<% if @event.attendees.include?(current_user) %>
  <%= button_to "Leave Event", leave_event_path(@event), method: :delete %>
<% else %>
  <%= button_to "Attend Event", attend_event_path(@event), method: :post %>
<% end %>

<h2>Attendees</h2>

<% @event.attendees.each do |attendee| %>
  <p><%= attendee.email %></p>
<% end %>

<% if current_user == @event.creator %>
  <h2>Invite a User</h2>

  <%= form_with url: invite_user_path(@event), method: :post do |form| %>
    <%= form.collection_select :user_id, User.all, :id, :email %>
    <%= form.submit "Invite" %>
  <% end %>
<% end %>