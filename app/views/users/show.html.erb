<h1><%= @user.email %></h1>

<h2>Upcoming Events</h2>

<% @user.attended_events.upcoming.each do |event| %>
  <h3><%= link_to event.name, event_path(event) %></h3>
  <p><%= event.date %></p>
  <p><%= event.location %></p>
<% end %>

<h2>Past Events</h2>

<% @user.attended_events.past.each do |event| %>
  <h3><%= link_to event.name, event_path(event) %></h3>
  <p><%= event.date %></p>
  <p><%= event.location %></p>
<% end %>